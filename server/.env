# LLM 配置（OpenAI 兼容格式）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-ac711758d1b24b9497f2f2b867bd8988
LLM_MODEL=deepseek-v4-flash

# Embedding 配置
# 方式一：本地 transformers.js（默认，无需联网 API Key）
EMBEDDING_MODE=local
EMBEDDING_LOCAL_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# 方式二：远程 API（如需启用，设 EMBEDDING_MODE=remote 并填以下）
# EMBEDDING_MODE=remote
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.deepseek.com/v1

# HuggingFace 镜像（解决国内下载模型慢的问题）
HF_ENDPOINT=https://hf-mirror.com

# SQLite 数据库文件路径
DB_PATH=./meta-agent.db

# 服务端口
PORT=3000

# 日志级别
LOG_LEVEL=info
